{% extends "base.html.j2" %}
{% block app_content %}
    <h1>Your Cart</h1>
    {% if items %}
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.product.name }}</td>
                        <td>
                            <form action="{{ url_for('update_cart', item_id=item.id) }}" method="post" class="form-inline">
                                <input type="number" name="quantity" value="{{ item.quantity }}" min="1" class="form-control" style="width: 90px;" />
                                <button class="btn btn-default" type="submit">Update</button>
                            </form>
                        </td>
                        <td>${{ '%.2f' | format(item.product.price) }}</td>
                        <td>${{ '%.2f' | format(item.total_price()) }}</td>
                        <td>
                            <form action="{{ url_for('update_cart', item_id=item.id) }}" method="post">
                                <button type="submit" name="remove" value="1" class="btn btn-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <p class="lead">Cart Total: <strong>${{ '%.2f' | format(total) }}</strong></p>
        <a href="{{ url_for('checkout') }}" class="btn btn-success">Proceed to Checkout</a>
    {% else %}
        <p>Your cart is empty.</p>
        <a href="{{ url_for('index') }}" class="btn btn-primary">Browse products</a>
    {% endif %}
{% endblock %}
