{% extends "base.html.j2" %}
{% block app_content %}
    <h1>Orders</h1>
    
    <div class="card mb-4">
        <div class="card-body">
            <form method="POST" class="d-flex gap-2">
                {{ form.hidden_tag() }}
                <div class="flex-grow-1">
                    {{ form.search(class="form-control", placeholder="Search by Order ID, User ID, or Username") }}
                </div>
                {{ form.submit(class="btn btn-primary") }}
                {% if search %}
                    <a href="{{ url_for('admin_orders') }}" class="btn btn-secondary">Clear</a>
                {% endif %}
            </form>
        </div>
    </div>

    {% if orders %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>User</th>
                    <th>User ID</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                    <tr>
                        <td>#{{ order.id }}</td>
                        <td>{{ order.user.username if order.user else 'N/A' }}</td>
                        <td>{{ order.user_id }}</td>
                        <td>${{ '%.2f' | format(order.total_amount) }}</td>
                        <td><span class="badge bg-{% if order.status == 'Pending' %}warning{% elif order.status == 'Completed' %}success{% else %}secondary{% endif %}">{{ order.status }}</span></td>
                        <td>{{ order.created_at.strftime('%Y-%m-%d %H:%M') if order.created_at else 'N/A' }}</td>
                        <td>
                            <a class="btn btn-sm btn-primary" href="{{ url_for('order_detail_admin', order_id=order.id) }}">View Details</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="text-muted">
            {% if search %}
                No orders found matching your search.
            {% else %}
                No orders available yet.
            {% endif %}
        </p>
    {% endif %}
{% endblock %}
