{% extends "base.html.j2" %}
{% block app_content %}
    <h1>Add User</h1>
    <form method="post">
        {{ form.hidden_tag() }}
        <div class="form-group">
            {{ form.username.label(class_="control-label") }}
            {{ form.username(class_="form-control") }}
            {% for error in form.username.errors %}
                <div class="text-danger">{{ error }}</div>
            {% endfor %}
        </div>
        <div class="form-group">
            {{ form.email.label(class_="control-label") }}
            {{ form.email(class_="form-control") }}
            {% for error in form.email.errors %}
                <div class="text-danger">{{ error }}</div>
            {% endfor %}
        </div>
        <div class="form-group">
            {{ form.about_me.label(class_="control-label") }}
            {{ form.about_me(class_="form-control") }}
            {% for error in form.about_me.errors %}
                <div class="text-danger">{{ error }}</div>
            {% endfor %}
        </div>
        <div class="checkbox">
            <label>
                {{ form.is_admin() }} {{ form.is_admin.label.text }}
            </label>
        </div>
        <button type="submit" class="btn btn-primary">Create User</button>
        <a class="btn btn-default" href="{{ url_for('admin_users') }}">Cancel</a>
    </form>
{% endblock %}