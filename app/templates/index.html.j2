{% extends "base.html.j2" %}
{% block app_content %}
    <div class="row">
        <div class="col-md-3">
            <h3>Categories</h3>
            <div class="list-group">
                <a href="{{ url_for('index') }}" class="list-group-item{% if not selected_type %} active{% endif %}">All</a>
                {% for type in product_types %}
                    <a href="{{ url_for('index', type=type.id) }}" class="list-group-item{% if selected_type == type.id %} active{% endif %}">{{ type.name }}</a>
                {% endfor %}
            </div>
            <form method="get" class="form-inline">
                <div class="form-group">
                    <input type="text" name="search" value="{{ search }}" class="form-control" placeholder="Search products">
                </div>
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </div>
        <div class="col-md-9">
            <h1>Hardware Catalog</h1>
            {% if products %}
                <div class="row">
                    {% for product in products %}
                        <div class="col-sm-6 col-md-4">
                            <div class="thumbnail">
                                {% if product.image_url %}
                                    <img src="{{ product.image_url }}" alt="{{ product.name }}">
                                {% endif %}
                                <div class="caption">
                                    <h4>{{ product.name }}</h4>
                                    <p>{{ product.description }}</p>
                                    <p>
                                        <strong>${{ '%.2f' | format(product.price) }}</strong>
                                        {% if product.is_on_sale %}
                                            <span class="text-danger">On Sale</span>
                                        {% endif %}
                                    </p>
                                    <p>
                                        <a href="{{ url_for('product_detail', product_id=product.id) }}" class="btn btn-primary" role="button">View</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                {% if pagination.has_prev or pagination.has_next %}
                    <nav aria-label="Page navigation">
                        <ul class="pager">
                            <li class="previous{% if not pagination.has_prev %} disabled{% endif %}">
                                <a href="{{ url_for('index', page=pagination.prev_num, search=search, type=selected_type) if pagination.has_prev else '#' }}">
                                    <span aria-hidden="true">&larr;</span> Previous
                                </a>
                            </li>
                            <li class="next{% if not pagination.has_next %} disabled{% endif %}">
                                <a href="{{ url_for('index', page=pagination.next_num, search=search, type=selected_type) if pagination.has_next else '#' }}">
                                    Next <span aria-hidden="true">&rarr;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                {% endif %}
            {% else %}
                <p>No products found.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
